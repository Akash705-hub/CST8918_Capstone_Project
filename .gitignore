# ==========================================
# Terraform
# ==========================================

**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Allow example variable files
!example.tfvars
!*.example.tfvars

# Terraform plan files
*.tfplan
*.tfplan.*

# Terraform lock file SHOULD be committed
# Do NOT ignore .terraform.lock.hcl


# ==========================================
# Node.js
# ==========================================

**/node_modules/
**/build/
**/dist/
**/.cache/
**/.parcel-cache/
**/.vite/
**/.next/
**/coverage/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime logs
*.log


# ==========================================
# Environment / Secrets
# ==========================================

.env
.env.*
!.env.example

# Common secret/config files
*.secret
*.key
*.pem


# ==========================================
# Docker
# ==========================================

# Local Docker override files
docker-compose.override.yml

# Docker environment files
docker.env


